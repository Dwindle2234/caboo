# Copy this file to .env (which git ignores) and fill in real values.
# Generate a key with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave it empty and Cabo makes a random key each time it starts (fine for now).
CABO_SECRET_KEY=

# Optional: address Unraid uses to fetch the dashboard icon (only needed if the default doesn't show)
# CABO_ICON_URL=http://<your-unraid-ip>:8088/static/icon.png
